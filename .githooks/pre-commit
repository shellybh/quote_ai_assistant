#!/bin/sh
# 1) Blocks the commit if a staged change contains a secret (gitleaks, values redacted).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found on PATH - commit blocked. Install: winget install gitleaks" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact -v || exit 1
# 2) Blocks the commit if a staged file contains a word from the forbidden list.
exec python tools/check_forbidden_words.py --staged
